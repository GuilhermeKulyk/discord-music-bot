# ===== Obrigatório =====
# Token do bot: Discord Developer Portal > sua aplicação > Bot > Reset Token
DISCORD_TOKEN=

# ===== Quem pode usar (opcional) =====
# Se OWNER_ID ficar vazio, o bot libera automaticamente o dono da aplicação no Discord (você).
OWNER_ID=
# Outros IDs autorizados, separados por vírgula (ex.: 123,456)
ALLOWED_USER_IDS=

# ===== Spotify (opcional) =====
# Crie um app em https://developer.spotify.com/dashboard e cole as credenciais.
# Sem elas, links do Spotify continuam funcionando pela página pública,
# mas playlists ficam limitadas às primeiras faixas (~50-100).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===== Ajustes (opcional) =====
# Volume inicial em %, de 0 a 200
DEFAULT_VOLUME=50
# Segundos parado (ou sozinho no canal) até sair da chamada
IDLE_TIMEOUT=300
# Máximo de faixas carregadas de uma playlist
MAX_PLAYLIST=200
# Caminho do ffmpeg.exe, se não estiver no PATH
FFMPEG_PATH=
# Caminho de um cookies.txt do YouTube (só se o YouTube começar a pedir login)
YTDL_COOKIES=
